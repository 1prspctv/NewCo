# InvoiceThis Environment Variables
# Copy this file to .env.local and fill in your values

# A secret key for signing JWT tokens (generate a random string)
JWT_SECRET=your-super-secret-key-change-this

# Stripe Configuration (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Your app's public URL (set this in Vercel dashboard)
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
